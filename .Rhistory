return_width<-function(n,B=1000){
X=rnorm(n,mean = 5,sd=sqrt(2))
mean_star=rep(0,B)
for(j in 1:B){
index_b=sample(1:n,n,replace = T)
X_b=X[index_b]
mean_star[j]=mean(X_b)
}
as.numeric(quantile(mean_star,0.975)-quantile(mean_star,0.025))
}
return_width(100)
return_width<-function(n,B=1000){
X=rnorm(n,mean = 5,sd=sqrt(2))
mean_star=rep(0,B)
for(j in 1:B){
index_b=sample(1:n,n,replace = T)
X_b=X[index_b]
mean_star[j]=mean(X_b)
}
as.numeric(quantile(mean_star,0.975)-quantile(mean_star,0.025))
}
width_n<-NULL
for(n in 3:500){
width_n<-c(width_n,return_width(n))
}
plot(3:500,width_n)
return_width<-function(n,B=1000){
X=rnorm(n,mean = 5,sd=sqrt(2))
mean_star=rep(0,B)
for(j in 1:B){
index_b=sample(1:n,n,replace = T)
X_b=X[index_b]
mean_star[j]=mean(X_b)
}
as.numeric(quantile(mean_star,0.975)-quantile(mean_star,0.025))
}
