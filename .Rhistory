install.packages("RMTstat")
n=1000
x=seq(-2,2,length.out = 100)
y=sqrt(4-x^2)/2/pi
X_n=matrix(runif(n*n),n,n)
#X_n=matrix(rnorm(n*n),n)/sqrt(n)
X_n[lower.tri(X_n)] = t(X_n)[lower.tri(X_n)]
eigen_value=eigen(X_n)$value
hist(eigen_value,breaks = seq(-3,3,length.out = 2*sqrt(n)),freq=FALSE)
lines(x,y,col=2)
