eigen_test(7)
eigen_test(7)^2
trace_test<-function(n,p){
sss=eigen_test(n)^(2*p)
ddd=sum(sss)
ddd^(1/2/p)
}
max(eigen_test(7))/trace_test(7,2)
max(eigen_test(7))/trace_test(7,3)
eigen_test(10)
rationp<-function(p){
choose(p,2*p)/2^(2*p)
}
